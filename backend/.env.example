# Rahasia untuk menandatangani token. WAJIB diganti. Contoh membuat: python -c "import secrets;print(secrets.token_hex(32))"
FMK_SECRET=ganti-dengan-rahasia-panjang-dan-acak
# Default SQLite (langsung jalan). Untuk PostgreSQL, hapus tanda # di baris bawah dan sesuaikan:
DATABASE_URL=sqlite:///./fmk.db
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/fmk
# Alamat frontend yang boleh mengakses API, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173
